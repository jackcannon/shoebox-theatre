{
  "name": "shoeboxtheatre",
  "version": "0.0.0",
  "description": "A game engine for 2D sprites in real 3D worlds, built on React Three Fiber.",
  "keywords": [
    "game-engine",
    "react-three-fiber",
    "three",
    "pixel-art",
    "sprites",
    "2.5d"
  ],
  "license": "MIT",
  "author": "Jack Cannon",
  "homepage": "https://github.com/jackcannon/shoebox-theatre#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackcannon/shoebox-theatre.git",
    "directory": "packages/engine"
  },
  "bugs": "https://github.com/jackcannon/shoebox-theatre/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@shoeboxtheatre/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.lib.json && cp src/ui/ui.css dist/ui/ui.css",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  }
}
